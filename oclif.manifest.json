    "analyze": {
      "aliases": [],
      "args": {},
      "description": "Analyze Salesforce profiles to inventory permissions, detect high-risk access, and score complexity",
      "examples": [
        "<%= config.bin %> analyze",
        "<%= config.bin %> analyze --source force-app/main/default/profiles",
        "<%= config.bin %> analyze --source path/to/Sales_User.profile-meta.xml",
        "<%= config.bin %> analyze --json"
      ],
      "flags": {
        "source": {
          "char": "s",
          "description": "Path to a profile file, directory, or glob pattern",
          "name": "source",
          "default": "force-app/main/default/profiles",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "json": {
          "description": "Format output as JSON",
          "name": "json",
          "allowNo": false,
          "type": "boolean"
        }
      },
      "hasDynamicHelp": false,
      "hiddenAliases": [],
      "id": "analyze",
      "pluginAlias": "permforge",
      "pluginName": "permforge",
      "pluginType": "core",
      "strict": true,
      "enableJsonFlag": false,
      "isESM": true,
      "relativePath": [
        "dist",
        "commands",
        "analyze.js"
      ]
    },
    "cluster": {
      "aliases": [],
      "args": {},
      "description": "Analyze all profiles together to extract a shared Standard Baseline Permission Set and isolate role-specific deltas",
      "examples": [
        "<%= config.bin %> cluster",
        "<%= config.bin %> cluster --source force-app/main/default/profiles",
        "<%= config.bin %> cluster --threshold 0.6 --base-name \"Global_Core_Access\"",
        "<%= config.bin %> cluster --output-dir force-app/main/default"
      ],
      "flags": {
        "source": {
          "char": "s",
          "description": "Path to profiles directory or glob pattern",
          "name": "source",
          "default": "force-app/main/default/profiles",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "threshold": {
          "char": "t",
          "description": "Frequency threshold for baseline inclusion (0.1 to 1.0)",
          "name": "threshold",
          "default": "0.75",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "base-name": {
          "description": "API Name for the generated shared baseline Permission Set",
          "name": "base-name",
          "default": "Standard_Employee_Baseline",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "output-dir": {
          "char": "d",
          "description": "Destination directory for generated permission sets and groups",
          "name": "output-dir",
          "default": "force-app/main/default",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "no-groups": {
          "description": "Do not generate Permission Set Groups",
          "name": "no-groups",
          "allowNo": false,
          "type": "boolean"
        },
        "json": {
          "description": "Format output as JSON",
          "name": "json",
          "allowNo": false,
          "type": "boolean"
        }
      },
      "hasDynamicHelp": false,
      "hiddenAliases": [],
      "id": "cluster",
      "pluginAlias": "permforge",
      "pluginName": "permforge",
      "pluginType": "core",
      "strict": true,
      "enableJsonFlag": false,
      "isESM": true,
      "relativePath": [
        "dist",
        "commands",
        "cluster.js"
      ]
