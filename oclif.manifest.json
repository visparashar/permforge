          "name": "output-dir",
          "default": "force-app/main/default",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "no-groups": {
          "description": "Do not generate Permission Set Groups",
          "name": "no-groups",
          "allowNo": false,
          "type": "boolean"
        },
        "json": {
          "description": "Format output as JSON",
          "name": "json",
          "allowNo": false,
          "type": "boolean"
        }
      },
      "hasDynamicHelp": false,
      "hiddenAliases": [],
      "id": "cluster",
      "pluginAlias": "permforge",
