          "name": "output-dir",
          "default": "force-app/main/default",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "strategy": {
          "description": "Decomposition strategy",
          "name": "strategy",
          "default": "by-domain",
          "hasDynamicHelp": false,
          "multiple": false,
          "options": [
            "by-domain",
            "by-object",
            "consolidated"
          ],
          "type": "option"
        },
        "prefix": {
