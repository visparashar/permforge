{
  "name": "vscode-permforge",
  "displayName": "PermForge: Salesforce Profile Migration & Parity Studio",
  "description": "Visual migration studio to decompose Salesforce profiles into modular Permission Sets and Permission Set Groups with 100% mathematical parity verification.",
  "version": "1.3.1",
  "publisher": "permforge",
  "repository": {
    "type": "git",
    "url": "https://github.com/visparashar/permforge"
  },
  "homepage": "https://visparashar.github.io/permforge",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "salesforce",
    "sfdx",
    "profile",
    "permission-set",
    "permission-set-group",
    "parity",
    "security"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:permforge-profiles",
    "workspaceContains:**/*.profile-meta.xml",
    "workspaceContains:**/*.profile",
    "onCommand:permforge.openStudio"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "permforge",
          "title": "PermForge",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "permforge": [
        {
          "id": "permforge-profiles",
          "name": "Salesforce Profiles",
          "visibility": "visible"
        },
        {
          "id": "permforge-permsets",
          "name": "Permission Sets & PSGs",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "permforge.openStudio",
        "title": "PermForge: Open Migration Studio",
        "category": "PermForge",
        "icon": "$(layout-dashboard)"
      },
      {
        "command": "permforge.openParityMatrix",
        "title": "PermForge: View Parity Matrix & Access Heatmap",
        "category": "PermForge",
        "icon": "$(table)"
      },
      {
        "command": "permforge.retrieveFromOrg",
        "title": "PermForge: Retrieve Profiles from Salesforce Org",
        "category": "PermForge",
        "icon": "$(cloud-download)"
      },
      {
        "command": "permforge.runPipeline",
        "title": "PermForge: Run End-to-End Enterprise Migration Pipeline",
        "category": "PermForge",
        "icon": "$(rocket)"
      },
      {
        "command": "permforge.refreshProfiles",
        "title": "PermForge: Refresh Profiles",
        "category": "PermForge",
        "icon": "$(refresh)"
      },
      {
        "command": "permforge.analyzeProfile",
        "title": "PermForge: Analyze Profile Complexity & Risks",
        "category": "PermForge"
      },
      {
        "command": "permforge.decomposeProfile",
        "title": "PermForge: Decompose into Permission Sets & PSG",
        "category": "PermForge",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "permforge.verifyParity",
        "title": "PermForge: Verify Access Parity",
        "category": "PermForge",
        "icon": "$(pass-filled)"
      },
      {
        "command": "permforge.stripProfile",
        "title": "PermForge: Sanitize & Strip Profile Permissions",
        "category": "PermForge",
        "icon": "$(trash)"
      },
      {
        "command": "permforge.clusterProfiles",
        "title": "PermForge: Cluster & Deduplicate Profiles",
        "category": "PermForge",
        "icon": "$(organization)"
      },
      {
        "command": "permforge.generateReport",
        "title": "PermForge: Generate Visual HTML Audit Report",
        "category": "PermForge",
        "icon": "$(file-text)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "permforge.retrieveFromOrg",
          "when": "view == permforge-profiles",
          "group": "navigation@0"
        },
        {
          "command": "permforge.openStudio",
          "when": "view == permforge-profiles",
          "group": "navigation@1"
        },
        {
          "command": "permforge.refreshProfiles",
          "when": "view == permforge-profiles",
          "group": "navigation@2"
        },
        {
          "command": "permforge.clusterProfiles",
          "when": "view == permforge-profiles",
          "group": "navigation@3"
        },
        {
          "command": "permforge.runPipeline",
          "when": "view == permforge-profiles",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "permforge.openStudio",
          "when": "view == permforge-profiles && viewItem == profile",
          "group": "inline@1"
        },
        {
          "command": "permforge.openParityMatrix",
          "when": "view == permforge-profiles && viewItem == profile",
          "group": "1_actions@0"
        },
        {
          "command": "permforge.decomposeProfile",
          "when": "view == permforge-profiles && viewItem == profile",
          "group": "1_actions@1"
        },
        {
          "command": "permforge.verifyParity",
          "when": "view == permforge-profiles && viewItem == profile",
          "group": "1_actions@2"
        },
        {
          "command": "permforge.stripProfile",
          "when": "view == permforge-profiles && viewItem == profile",
          "group": "1_actions@3"
        }
      ],
      "explorer/context": [
        {
          "command": "permforge.openStudio",
          "when": "resourceExtname == .profile-meta.xml || resourceExtname == .profile",
          "group": "permforge@1"
        },
        {
          "command": "permforge.openParityMatrix",
          "when": "resourceExtname == .profile-meta.xml || resourceExtname == .profile",
          "group": "permforge@2"
        },
        {
          "command": "permforge.analyzeProfile",
          "when": "resourceExtname == .profile-meta.xml || resourceExtname == .profile",
          "group": "permforge@3"
        },
        {
          "command": "permforge.decomposeProfile",
          "when": "resourceExtname == .profile-meta.xml || resourceExtname == .profile",
          "group": "permforge@4"
        },
        {
          "command": "permforge.stripProfile",
          "when": "resourceExtname == .profile-meta.xml || resourceExtname == .profile",
          "group": "permforge@5"
        }
      ]
    },
    "configuration": {
      "title": "PermForge",
      "properties": {
        "permforge.profilesDirectory": {
          "type": "string",
          "default": "force-app/main/default/profiles",
          "description": "Default directory or glob pattern for Salesforce profile files."
        },
        "permforge.outputDirectory": {
          "type": "string",
          "default": "force-app/main/default",
          "description": "Default destination directory for generated Permission Sets and Groups."
        },
        "permforge.clusteringThreshold": {
          "type": "number",
          "default": 0.75,
          "minimum": 0.1,
          "maximum": 1,
          "description": "Default sharing threshold frequency for inclusion in the Standard Employee Baseline."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "package": "npm run build && vsce package --no-dependencies --no-git-tag-version"
  },
  "dependencies": {
    "permforge": "file:.."
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3"
  }
}
